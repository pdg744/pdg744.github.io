{
  "expo": {
    "name": "MathExplorers",
    "slug": "math-explorers",
    "version": "1.0.0",
    "scheme": "mathexplorers",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    },
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "xyz.mathexplorers.app",
      "supportsTablet": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a981964-1473-432d-aae7-265694bea0ee"
      }
    },
    "owner": "pgaf"
  }
}
